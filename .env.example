ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
TMDB_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_CALENDAR_CREDENTIALS_PATH=./secrets/google_credentials.json
LATER_API_TOKEN=change-me
TIMEZONE=America/Los_Angeles
HOME_LAT=37.7749
HOME_LNG=-122.4194

# TLS on a machine running antivirus that intercepts HTTPS (e.g. Norton).
# Python ships its own CA bundle and will not trust the AV's generated root,
# so API calls fail with CERTIFICATE_VERIFY_FAILED. Build a merged bundle with
# scripts/rebuild_ca_bundle.py and point this at it. Leave blank if your
# machine does not intercept TLS.
SSL_CERT_FILE=
